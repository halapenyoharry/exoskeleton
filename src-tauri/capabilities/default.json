{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main Exoskeleton window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "pty:default",
    "store:default",
    "log:default",
    "shell:default"
  ]
}