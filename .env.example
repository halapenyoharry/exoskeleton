# Build-time options for the web build (Vite reads VITE_* at `npm run build`).
# Copy to .env.local to set locally; the outer-rim deploy script sets these
# from its own config per run.

# Layout preset first-run web visitors open with: blank | minimal | json-lab |
# av-lab | procedural-lab | everything. Default: blank.
VITE_WEB_DEFAULT_PRESET=blank
