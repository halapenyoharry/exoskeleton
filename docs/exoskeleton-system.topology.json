  "metadata": {
    "title": "Exoskeleton system topology",
    "source": "hand-verified against src/ and src-tauri/ on 2026-10-08; restructured from a Gemini Mermaid map (exoskeleton_full_system.mmd)",
    "schema": "TopoDocument (src/panels/json-dyadic/types.ts): kind node | hyperedge, i2t:edge_category, layer",
    "reading_note": "No direction is privileged. Containment is nesting, not order. Spoke roles name incidence in a relation; they are not left/right or up/down. Load one layer at a time in json-dyadic.",
    "layers": {
      "membranes": "containment: what is inside what",
      "transformations": "state_change: where something becomes something else",
      "couplings": "interactivity: mutual, bidirectional links",
      "pointers": "reference: lightweight pointers with no structural weight"
    },
    "unverified": ["op:external-gear (what physical device sends OSC is not recorded in the repo)"]
  },
