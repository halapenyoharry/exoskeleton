{
  "name": "keyboard",
  "extends": "base",
  "devices": ["keyboard"],
  "comment": "Movement by code (layout independent), mnemonics by key. Nothing fires while typing. Held keys are axes.",
  "rows": [
    { "gesture": "key.hold", "code": "ArrowLeft", "when": ["!typing"], "action": "view.pan", "params": { "axis": "x", "sign": 1, "speed": 400 } },
    { "gesture": "key.hold", "code": "ArrowRight", "when": ["!typing"], "action": "view.pan", "params": { "axis": "x", "sign": -1, "speed": 400 } },
    { "gesture": "key.hold", "code": "ArrowUp", "when": ["!typing"], "action": "view.pan", "params": { "axis": "y", "sign": 1, "speed": 400 } },
    { "gesture": "key.hold", "code": "ArrowDown", "when": ["!typing"], "action": "view.pan", "params": { "axis": "y", "sign": -1, "speed": 400 } },
    { "gesture": "key.hold", "code": "KeyW", "when": ["!typing"], "action": "view.pan", "params": { "axis": "y", "sign": 1, "speed": 400 } },
    { "gesture": "key.hold", "code": "KeyS", "when": ["!typing"], "action": "view.pan", "params": { "axis": "y", "sign": -1, "speed": 400 } },
    { "gesture": "key.hold", "code": "KeyA", "when": ["!typing"], "action": "view.pan", "params": { "axis": "x", "sign": 1, "speed": 400 } },
    { "gesture": "key.hold", "code": "KeyD", "when": ["!typing"], "action": "view.pan", "params": { "axis": "x", "sign": -1, "speed": 400 } },
    { "gesture": "key", "key": "+", "when": ["!typing"], "action": "view.zoomInStep" },
    { "gesture": "key", "key": "=", "when": ["!typing"], "action": "view.zoomInStep" },
    { "gesture": "key", "key": "-", "when": ["!typing"], "action": "view.zoomOutStep" },
    { "gesture": "key", "key": "_", "when": ["!typing"], "action": "view.zoomOutStep" },
    { "gesture": "key.hold", "code": "KeyQ", "when": ["!typing"], "action": "view.rotate", "params": { "sign": -1, "speed": 1.2 } },
    { "gesture": "key.hold", "code": "KeyE", "when": ["!typing"], "action": "view.rotate", "params": { "sign": 1, "speed": 1.2 } },
    { "gesture": "key", "key": "f", "when": ["!typing"], "action": "view.fit" },
    { "gesture": "key", "key": "h", "when": ["!typing"], "action": "view.home" },
    { "gesture": "key", "key": "Tab", "when": ["!typing"], "action": "nav.next" },
    { "gesture": "key", "key": "Tab", "modifiers": { "shift": true }, "when": ["!typing"], "action": "nav.prev" },
    { "gesture": "key", "key": "Enter", "when": ["!typing"], "action": "nav.activate" },
    { "gesture": "key", "key": " ", "when": ["!typing"], "action": "nav.activate" },
    { "gesture": "key", "key": "Escape", "action": "nav.back" },
    { "gesture": "key", "key": "ArrowLeft", "when": ["reader"], "action": "nav.prev" },
    { "gesture": "key", "key": "ArrowRight", "when": ["reader"], "action": "nav.next" },
    { "gesture": "chord", "keys": ["Meta", "z"], "action": "view.undo" },
    { "gesture": "chord", "keys": ["Control", "z"], "action": "view.undo" },
    { "gesture": "chord", "keys": ["Meta", "Shift", "z"], "action": "view.redo" },
    { "gesture": "chord", "keys": ["Control", "Shift", "z"], "action": "view.redo" },
    { "gesture": "key", "key": "`", "when": ["!typing"], "action": "profile.next" }
  ]
}
