{
  "name": "post-pipe-engine",
  "extends": "base",
  "devices": ["mouse", "trackpad", "touch", "pen", "keyboard"],
  "comment": "post-pipe's engine defaults, row for row from src/lib/actions.js defaultBindings plus what docs/ACTIONS.md lists as fixed. graph.collapseGesture 'doubletap' swaps the first two container rows. Loading this profile should leave a site behaving exactly as it does today.",
  "thresholds": { "doubleTapMs": 250, "doubleTapPx": 32, "longPressMs": 500, "longPressSlopPx": 8, "dragSlopPx": 5, "wheelStepMax": 0.32, "zoomStep": 1.25, "readablePx": 16 },
  "rows": [
    { "target": "container", "gesture": "tap", "action": "container.toggle" },
    { "target": "container", "gesture": "doubletap", "action": "view.zoomAtPoint" },
    { "target": "container", "gesture": "drag", "action": "node.move" },
    { "target": "node", "gesture": "tap", "action": "node.select" },
    { "target": "node", "gesture": "doubletap", "action": "node.openReader" },
    { "target": "node", "gesture": "drag", "action": "node.move" },
    { "target": "node", "gesture": "drag", "region": "edge", "action": "node.resize" },
    { "target": "space", "gesture": "tap", "action": "view.deselect" },
    { "target": "space", "gesture": "doubletap", "action": "view.zoomAtPoint" },
    { "target": "space", "gesture": "drag", "action": "view.pan" },
    { "target": "edge", "gesture": "doubletap", "action": "view.zoomAtPoint" },
    { "target": "tag", "gesture": "doubletap", "action": "view.zoomAtPoint" },
    { "target": "tag", "gesture": "tap", "action": "app.tagHighlight" },
    { "target": "tag", "gesture": "hover", "action": "app.tagPill" },
    { "target": "edge", "gesture": "tap", "action": "app.edgeLabel" },
    { "target": "edge", "gesture": "hover", "action": "app.edgeLabel" },
    { "target": "link", "gesture": "tap", "action": "app.followLink" },
    { "gesture": "wheel", "action": "view.zoom" },
    { "gesture": "pinch", "action": "view.zoom" },
    { "gesture": "twist", "action": "view.rotate" },
    { "gesture": "twofinger.doubletap", "action": "view.zoomOutStep", "params": { "about": "point", "ratio": 0.5 } },
    { "gesture": "key", "key": "+", "when": ["!typing", "!cover", "!settings"], "action": "view.zoomInStep" },
    { "gesture": "key", "key": "=", "when": ["!typing", "!cover", "!settings"], "action": "view.zoomInStep" },
    { "gesture": "key", "key": "-", "when": ["!typing", "!cover", "!settings"], "action": "view.zoomOutStep" },
    { "gesture": "key", "key": "_", "when": ["!typing", "!cover", "!settings"], "action": "view.zoomOutStep" },
    { "gesture": "chord", "keys": ["Meta", "z"], "action": "view.undo" },
    { "gesture": "chord", "keys": ["Control", "z"], "action": "view.undo" },
    { "gesture": "chord", "keys": ["Meta", "Shift", "z"], "action": "view.redo" },
    { "gesture": "chord", "keys": ["Control", "Shift", "z"], "action": "view.redo" },
    { "gesture": "key", "key": "Escape", "action": "nav.back" },
    { "gesture": "key", "key": "ArrowLeft", "when": ["reader"], "action": "nav.prev" },
    { "gesture": "key", "key": "ArrowRight", "when": ["reader"], "action": "nav.next" },
    { "gesture": "swipe.left", "when": ["reader"], "action": "nav.next" },
    { "gesture": "swipe.right", "when": ["reader"], "action": "nav.prev" },
    { "gesture": "key", "key": "ArrowDown", "when": ["cover"], "action": "app.coverDown" },
    { "gesture": "key", "key": "PageDown", "when": ["cover"], "action": "app.coverDown" },
    { "gesture": "key", "key": " ", "when": ["cover", "!typing"], "action": "app.coverDown" },
    { "gesture": "key", "key": "ArrowUp", "when": ["cover"], "action": "app.coverUp" },
    { "gesture": "key", "key": "PageUp", "when": ["cover"], "action": "app.coverUp" }
  ]
}
