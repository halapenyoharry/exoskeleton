      </mxCell>
<mxCell id="f4" value="one contract (title · sections · about), three sizes. The manifest declares menu, slots, settings, about; the host draws them." style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" vertex="1" parent="1">
        <mxGeometry x="1140" y="622" width="400" height="40" as="geometry"/>
      </mxCell>
<mxCell id="g0" value="G · WHAT A PANEL DECLARES (manifest), WHAT THE HOST DRAWS" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="40" y="740" width="700" height="20" as="geometry"/>
      </mxCell>
<mxCell id="g1" value="manifest {&#10;  id, title, glyph, accent&#10;  menu:     [ …items… ]            → ≡&#10;  slots:    [ up to 5 × {type, param, icon, tooltip} ] → the squares&#10;  controls: [ …more of the same… ]  → compact controls (optional)&#10;  settings: { followActive, pinned, … } → PANE SETTINGS zone&#10;  about:    { description, docs }   → about&#10;}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#3a4a6a;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
        <mxGeometry x="40" y="770" width="560" height="150" as="geometry"/>
      </mxCell>
<mxCell id="g2" value="host rules (fixed, not per panel):&#10;· slot = 44×44, gap 8 → 5 slots ≈ 252px; below 240px pane width the pill is glyph-only and slots go 2-up&#10;· drawer overlays content; resizable; orientation per pane, remembered&#10;· scrim darkening + blur are global settings&#10;· slot types are the only vocabulary: segmented · toggle · swatch · dial · stepper (no free text)&#10;· every control has a tooltip in plain words" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#3a4a6a;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
        <mxGeometry x="620" y="770" width="560" height="150" as="geometry"/>
      </mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
