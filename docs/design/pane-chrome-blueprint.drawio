<mxCell id="d6" value="pills = △ title ×  (no +). Active pane solid, others outline. Click to switch, drag to move. Narrow group: pills collapse to glyphs." style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" vertex="1" parent="1">
        <mxGeometry x="52" y="548" width="536" height="30" as="geometry"/>
      </mxCell>
<mxCell id="d7" value="DECIDE: a lone pane is also a group — does its pill keep the + (as drawn in A), or does + always sit in the group controls top-right, even for one pane? Proposal: always top-right, so the rule has no exceptions." style="text;html=1;align=left;fontColor=#ff4d8d;fontSize=10;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="40" y="695" width="560" height="20" as="geometry"/>
      </mxCell>
<mxCell id="e0" value="E · PANE SETTINGS zone (contents)" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="660" y="440" width="400" height="20" as="geometry"/>
      </mxCell>
<mxCell id="e1" value="⤢ maximize / restore&#10;⤴ pop out (desktop only)&#10;⇄ move to… (touch has no drag)&#10;🔗 follow active document / pin to a document&#10;◆ accent color&#10;▭ show compact controls" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
        <mxGeometry x="660" y="470" width="300" height="120" as="geometry"/>
      </mxCell>
<mxCell id="e2" value="= what the pill ☰ shows below the rule today.&#10;Pane-scoped, not component-scoped." style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" vertex="1" parent="1">
        <mxGeometry x="970" y="470" width="200" height="40" as="geometry"/>
      </mxCell>
<mxCell id="f0" value="F · SAME SHAPE, THREE SCALES" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="1140" y="440" width="400" height="20" as="geometry"/>
      </mxCell>
