        <mxGeometry x="40" y="395" width="420" height="20" as="geometry"/>
      </mxCell>
<mxCell id="d0" value="D · GROUP WITH 2+ PANES (proposal: a row of title pills, no tab strip)" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="40" y="440" width="600" height="20" as="geometry"/>
