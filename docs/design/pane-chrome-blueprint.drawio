<mxCell id="a5" value="△ opens the drawer (B/C)&#10;◆ glyph + accent = identity&#10;title = drag handle&#10;+ = add a sibling pane here&#10;× = close this pane" style="text;html=1;align=left;fontColor=#8896a0;fontSize=10;fontFamily=Menlo;verticalAlign=top" vertex="1" parent="1">
