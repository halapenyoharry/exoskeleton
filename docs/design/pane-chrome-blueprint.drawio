      </mxCell>
<mxCell id="f2" value="PANE  △ → drawer&#10;strip of 4 (tab|button) · grid or stack body · ⚙ · about" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;fontColor=#18ffff;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
        <mxGeometry x="1160" y="524" width="360" height="44" as="geometry"/>
      </mxCell>
<mxCell id="f3" value="CELL  one grid cell (1×1 … 3×1) → one visual control" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#ffd166;fontColor=#ffd166;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10" vertex="1" parent="1">
        <mxGeometry x="1180" y="578" width="320" height="34" as="geometry"/>
      </mxCell>
<mxCell id="f4" value="one contract (title · sections · about), three sizes. The manifest declares menu, strip, settings, about; the host draws them." style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" vertex="1" parent="1">
        <mxGeometry x="1140" y="622" width="400" height="40" as="geometry"/>
      </mxCell>
<mxCell id="g0" value="G · WHAT A PANEL DECLARES (manifest), WHAT THE HOST DRAWS" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1">
        <mxGeometry x="40" y="740" width="700" height="20" as="geometry"/>
      </mxCell>
<mxCell id="g2" value="host rules (fixed, not per panel):&#10;· grid unit 52px, gap 8; cells span 1×1, 2×1, 2×2, 3×1; below 240px pane width the pill is glyph-only&#10;· drawer overlays content; resizable; orientation per pane, remembered&#10;· scrim darkening + blur are global settings&#10;· cell types are the only vocabulary: segmented · toggle · swatch · dial · stepper (no free text)&#10;· every control has a tooltip in plain words" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#3a4a6a;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
        <mxGeometry x="620" y="770" width="560" height="150" as="geometry"/>
      </mxCell>
<mxCell id="b0" value="B · EXPANDED — drawer (header strip of 4 positions; body = active tab)" style="text;html=1;align=left;verticalAlign=top;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" vertex="1" parent="1"><mxGeometry x="520" y="60" width="560" height="20" as="geometry"/></mxCell>
