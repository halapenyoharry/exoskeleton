nter;fontColor=#3a4a6a;fontSize=11;fontFamily=Menlo" value="pane content" vertex="1"><mxGeometry height="20" width="250" x="1290" y="230" as="geometry"/></mxCell><mxCell id="d0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="D · GROUP WITH 2+ PANES (proposal: a row of title pills, no tab strip)" vertex="1"><mxGeometry height="20" width="600" x="40" y="440" as="geometry"/></mxCell><mxCell id="d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f1433;strokeColor=#1f2a4d;strokeWidth=1;" value="" vertex="1"><mxGeometry height="220" width="560" x="40" y="470" as="geometry"/></mxCell><mxCell id="d2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;opacity=35;" value="" vertex="1"><mxGeometry height="52" width="560" x="40" y="470" as="geometry"/></mxCell><mxCell id="d3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1.5;fontColor=#18ffff;fontFamily=Menlo;fontSize=11;" value="△ ◆ editor  ×" vertex="1"><mxGeometry height="30" width="120" x="52" y="480" as="geometry"/></mxCell><mxCell id="d4" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ffd166;strokeWidth=1;fontColor=#ffd166;fontFamily=Menlo;fontSize=11;opacity=70" value="△ ⌖ 3D-Inspect  ×" vertex="1"><mxGeometry height="30" width="150" x="180" y="480" as="geometry"/></mxCell><mxCell id="d5" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8896a0;strokeWidth=1;fontColor=#8896a0;fontFamily=Menlo;fontSize=12" value="+" vertex="1"><mxGeometry height="30" width="30" x="338" y="480" as="geometry"/></mxCell><mxCell id="d6" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" value="active pane = solid pill; others = outline. Click a pill to switch; drag a pill to move the pane. Narrow group: pills collapse to glyphs." vertex="1"><mxGeometry height="30" width="536" x="52" y="530" as="geometry"/></mxCell><mxCell id="d7" parent="1" style="text;html=1;align=left;fontColor=#ff4d8d;fontSize=10;fontFamily=Menlo" value="DECIDE: is this right, or keep Dockview's plain tab strip for 2+ panes (what you have today, and said was fine)?" vertex="1"><mxGeometry height="20" width="560" x="40" y="695" as="geometry"/></mxCell><mxCell id="e0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="E · PANE SETTINGS zone (contents)" vertex="1"><mxGeometry height="20" width="400" x="660" y="440" as="geometry"/></mxCell><mxCell id="e1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" value="⤢ maximize / restore&#10;⤴ pop out (desktop only)&#10;⇄ move to… (touch has no drag)&#10;🔗 follow active document / pin to a document&#10;◆ accent color&#10;▭ show compact controls" vertex="1"><mxGeometry height="120" width="300" x="660" y="470" as="geometry"/></mxCell><mxCell id="e2" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" value="= what the pill ☰ shows below the rule today.&#10;Pane-scoped, not component-scoped." vertex="1"><mxGeometry height="40" width="200" x="970" y="470" as="geometry"/></mxCell><mxCell id="f0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="F · SAME SHAPE, THREE SCALES" vertex="1"><mxGeometry height="20" width="400" x="1140" y="440" as="geometry"/></mxCell><mxCell id="f1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#8896a0;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10" value="APP  ⊞ → floating menu pane&#10;sections · about" vertex="1"><mxGeometry height="44" width="400" x="1140" y="470" as="geometry"/></mxCell><mxCell id="f2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;fontColor=#18ffff;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10" value="PANE  △ → drawer&#10;zones · 5 slots · compact controls · about" vertex="1"><mxGeometry height="44" width="360" x="1160" y="524" as="geometry"/></mxCell><mxCell id="f3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#ffd166;fontColor=#ffd166;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10" value="SLOT  one 44×44 square → one visual control" vertex="1"><mxGeometry height="34" width="320" x="1180" y="578" as="geometry"/></mxCell><mxCell id="f4" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" value="one contract (title · sections · about), three sizes. The manifest declares menu, slots, settings, about; the host draws them." vertex="1"><mxGeometry height="40" width="400" x="1140" y="622" as="geometry"/></mxCell><mxCell id="g0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="G · WHAT A PANEL DECLARES (manifest), WHAT THE HOST DRAWS" vertex="1"><mxGeometry height="20" width="700" x="40" y="740" as="geometry"/></mxCell><mxCell id="g1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#3a4a6a;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" value="manifest {&#10;  id, title, glyph, accent&#10;  menu:     [ …items… ]            → ≡&#10;  slots:    [ up to 5 × {type, param, icon, tooltip} ] → the squares&#10;  controls: [ …more of the same… ]  → compact controls (optional)&#10;  settings: { followActive, pinned, … } → PANE SETTINGS zone&#10;  about:    { description, docs }   → about&#10;}" vertex="1"><mxGeometry height="150" width="560" x="40" y="770" as="geometry"/></mxCell><mxCell id="g2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#3a4a6a;fontColor=#8896a0;fontFamily=Menlo;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" value="host rules (fixed, not per panel):&#10;· slot = 44×44, gap 8 → 5 slots ≈ 252px; below 240px pane width the pill is glyph-only and slots go 2-up&#10;· drawer overlays content; resizable; orientation per pane, remembered&#10;· scrim darkening + blur are global settings&#10;· slot types are the only vocabulary: segmented · toggle · swatch · dial · stepper (no free text)&#10;· every control has a tooltip in plain words" vertex="1"><mxGeometry height="150" width="560" x="620" y="770" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>