<mxfile host="app.diagrams.net" type="device"><diagram id="pane-chrome" name="Pane chrome blueprint"><mxGraphModel dx="1896" dy="973" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="1080" background="#0a0e27" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#8896a0;fontSize=12;fontFamily=Menlo" value="EXOSKELETON — PANE CHROME BLUEPRINT (draft for Harold, 2026-10-11). Dark boxes = pane content. Pills and drawers float over content; content never reflows. Edit anything; red notes are open decisions." vertex="1"><mxGeometry height="30" width="1400" x="40" y="20" as="geometry"/></mxCell><mxCell id="a0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="A · COLLAPSED (default)" vertex="1"><mxGeometry height="20" width="300" x="40" y="60" as="geometry"/></mxCell><mxCell id="a1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f1433;strokeColor=#1f2a4d;strokeWidth=1;" value="" vertex="1"><mxGeometry height="300" width="420" x="40" y="90" as="geometry"/></mxCell><mxCell id="a2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;opacity=35;" value="" vertex="1"><mxGeometry height="60" width="420" x="40" y="90" as="geometry"/></mxCell><mxCell id="a2n" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=10;fontFamily=Menlo;verticalAlign=top" value="scrim: slight darkening + slight blur under the title area&#10;(two GLOBAL settings, not per pane; no lines)" vertex="1"><mxGeometry height="40" width="260" x="200" y="100" as="geometry"/></mxCell><mxCell id="a3" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1.5;fontColor=#18ffff;fontFamily=Menlo;fontSize=12;align=left;spacingLeft=12;" value="△  ◆ editor            +  ×" vertex="1"><mxGeometry height="32" width="150" x="52" y="100" as="geometry"/></mxCell><mxCell id="a4" parent="1" style="text;html=1;align=center;fontColor=#3a4a6a;fontSize=11;fontFamily=Menlo" value="pane content (full height, top to bottom)" vertex="1"><mxGeometry height="20" width="420" x="40" y="230" as="geometry"/></mxCell><mxCell id="a5" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=10;fontFamily=Menlo;verticalAlign=top" value="△ opens the drawer (B/C)&#10;◆ glyph + accent = identity&#10;title = drag handle&#10;+ = add a sibling pane here&#10;× = close this pane" vertex="1"><mxGeometry height="80" width="300" x="52" y="300" as="geometry"/></mxCell><mxCell id="a6" parent="1" style="text;html=1;align=left;fontColor=#ff4d8d;fontSize=10;fontFamily=Menlo" value="DECIDE: corner — left (drawn) or right (said)? Proposal: left, global setting." vertex="1"><mxGeometry height="20" width="420" x="40" y="395" as="geometry"/></mxCell><mxCell id="b0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="B · EXPANDED — drawer, HORIZONTAL orientation" vertex="1"><mxGeometry height="20" width="400" x="520" y="60" as="geometry"/></mxCell><mxCell id="b1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f1433;strokeColor=#1f2a4d;strokeWidth=1;" value="" vertex="1"><mxGeometry height="300" width="560" x="520" y="90" as="geometry"/></mxCell><mxCell id="b2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1.5;opacity=95;" value="" vertex="1"><mxGeometry height="186" width="536" x="532" y="100" as="geometry"/></mxCell><mxCell id="b3" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontFamily=Menlo;fontSize=12;spacingLeft=10;verticalAlign=middle" value="▽  ◆ editor      ≡            +  ×" vertex="1"><mxGeometry height="28" width="300" x="532" y="104" as="geometry"/></mxCell><mxCell id="b3n" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" value="≡ = component menu (New, Open, Library…)&#10;from manifest.menu" vertex="1"><mxGeometry height="28" width="220" x="840" y="104" as="geometry"/></mxCell><mxCell id="b4" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#18ffff;strokeColor=none;fontColor=#0a0e27;fontFamily=Menlo;fontSize=10;fontStyle=1" value="CONTROLS" vertex="1"><mxGeometry height="22" width="90" x="544" y="136" as="geometry"/></mxCell><mxCell id="b5" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#18ffff;fontColor=#18ffff;fontFamily=Menlo;fontSize=10" value="PANE SETTINGS" vertex="1"><mxGeometry height="22" width="110" x="640" y="136" as="geometry"/></mxCell><mxCell id="b6" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8896a0;fontColor=#8896a0;fontFamily=Menlo;fontSize=12" value="⇅" vertex="1"><mxGeometry height="22" width="28" x="1030" y="136" as="geometry"/></mxCell><mxCell id="b6n" parent="1" style="text;html=1;align=right;fontColor=#8896a0;fontSize=9;fontFamily=Menlo" value="orientation button (not a tab): flips B ⇄ C" vertex="1"><mxGeometry height="18" width="255" x="770" y="138" as="geometry"/></mxCell><mxCell id="b7a" parent="1" style="whiteSpace=wrap;html=1;fillColor=#121a3d;strokeColor=#18ffff;strokeWidth=1;fontColor=#18ffff;fontFamily=Menlo;fontSize=9;dashed=0" value="2D|3D" vertex="1"><mxGeometry height="44" width="44" x="544" y="166" as="geometry"/></mxCell><mxCell id="b7b" parent="1" style="whiteSpace=wrap;html=1;fillColor=#121a3d;strokeColor=#18ffff;strokeWidth=1;fontColor=#ffd166;fontFamily=Menlo;fontSize=9" value="●●●●" vertex="1"><mxGeometry height="44" width="44" x="596" y="166" as="geometry"/></mxCell><mxCell id="b7c" parent="1" style="whiteSpace=wrap;html=1;fillColor=#121a3d;strokeColor=#18ffff;strokeWidth=1;fontColor=#18ffff;fontFamily=Menlo;fontSize=9" value="◯|⬡" vertex="1"><mxGeometry height="44" width="44" x="648" y="166" as="geometry"/></mxCell><mxCell id="b7d" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3a4a6a;strokeWidth=1;dashed=1" value="" vertex="1"><mxGeometry height="44" width="44" x="700" y="166" as="geometry"/></mxCell><mxCell id="b7e" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3a4a6a;strokeWidth=1;dashed=1" value="" vertex="1"><mxGeometry height="44" width="44" x="752" y="166" as="geometry"/></mxCell><mxCell id="b7n" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo;verticalAlign=top" value="5 SLOTS, fixed 44×44 each (touch minimum).&#10;Slot types: segmented · toggle · swatch · dial · stepper.&#10;Our user picks what goes here for their users.&#10;Empty slots drawn dashed. Visual, not text." vertex="1"><mxGeometry height="52" width="256" x="810" y="162" as="geometry"/></mxCell><mxCell id="b8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3a4a6a;strokeWidth=1;dashed=1;fontColor=#8896a0;fontFamily=Menlo;fontSize=9;align=left;spacingLeft=8" value="pane component controls (optional) — overflow beyond 5 slots, same primitives, wraps" vertex="1"><mxGeometry height="28" width="514" x="544" y="218" as="geometry"/></mxCell><mxCell id="b9" parent="1" style="text;html=1;align=left;fontColor=#3a4a6a;fontSize=8;fontFamily=Menlo" value="〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰" vertex="1"><mxGeometry height="12" width="514" x="544" y="248" as="geometry"/></mxCell><mxCell id="b10" parent="1" style="text;html=1;align=left;fontColor=#8896a0;fontSize=9;fontFamily=Menlo" value="about — manifest.description · docs link · version" vertex="1"><mxGeometry height="18" width="514" x="544" y="262" as="geometry"/></mxCell><mxCell id="b11" parent="1" style="text;html=1;align=center;fontColor=#3a4a6a;fontSize=10;fontFamily=Menlo" value="pane content continues underneath (drawer overlays; resize handle on drawer's bottom edge)" vertex="1"><mxGeometry height="20" width="560" x="520" y="320" as="geometry"/></mxCell><mxCell id="b12" parent="1" style="text;html=1;align=left;fontColor=#ff4d8d;fontSize=10;fontFamily=Menlo" value="DECIDE: always 5 squares (empties shown) or up to 5? · overlay vs push content? (proposal: overlay)" vertex="1"><mxGeometry height="20" width="560" x="520" y="395" as="geometry"/></mxCell><mxCell id="c0" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontSize=13;fontStyle=1;fontFamily=Menlo" value="C · EXPANDED — drawer, VERTICAL orientation" vertex="1"><mxGeometry height="20" width="400" x="1140" y="60" as="geometry"/></mxCell><mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f1433;strokeColor=#1f2a4d;strokeWidth=1;" value="" vertex="1"><mxGeometry height="300" width="420" x="1140" y="90" as="geometry"/></mxCell><mxCell id="c2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0a0e27;strokeColor=#18ffff;strokeWidth=1.5;opacity=95;" value="" vertex="1"><mxGeometry height="280" width="120" x="1152" y="100" as="geometry"/></mxCell><mxCell id="c3" parent="1" style="text;html=1;align=left;fontColor=#18ffff;fontFamily=Menlo;fontSize=11;spacingLeft=8;verticalAlign=top" value="▽ ◆ editor&#10;≡        + ×" vertex="1"><mxGeometry height="34" width="120" x="1152" y="104" as="geometry"/></mxCell><mxCell id="c4" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#18ffff;strokeColor=none;fontColor=#0a0e27;fontFamily=Menlo;fontSize=9;fontStyle=1" value="CTRL" vertex="1"><mxGeometry height="20" width="42" x="1160" y="142" as="geometry"/></mxCell><mxCell id="c5" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#18ffff;fontColor=#18ffff;fontFamily=Menlo;fontSize=9" value="SET" vertex="1"><mxGeometry height="20" width="34" x="1206" y="142" as="geometry"/></mxCell><mxCell id="c6" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;h